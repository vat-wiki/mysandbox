{
  "name": "mysandbox",
  "version": "0.11.1",
  "description": "Web control panel for dev containers - terminal, lifecycle, batch config.",
  "type": "module",
  "bin": {
    "mysandbox": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "web/dist",
    "config.default.yaml",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch server/cli.ts --host auto",
    "serve": "tsx server/cli.ts",
    "start": "npm run build && node dist/server/cli.js",
    "typecheck": "tsc --noEmit",
    "build:server": "tsc",
    "build:web": "npm -C web run build",
    "build": "npm run build:server && npm run build:web",
    "postbuild": "if [ -f mux/target/x86_64-unknown-linux-musl/release/msmux ]; then mkdir -p dist/bin && cp mux/target/x86_64-unknown-linux-musl/release/msmux dist/bin/msmux; else echo '>> msmux binary not built; run npm run build:mux before deploying or packaging'; fi",
    "prepublishOnly": "npm run build:mux && npm run build",
    "build:mux": "MSMUX_BUILD_VERSION=${MSMUX_BUILD_VERSION:-$(node -p \"require('./package.json').version\")} CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=${CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER:-musl-gcc} cargo build --manifest-path mux/Cargo.toml --release --target x86_64-unknown-linux-musl",
    "test:mux": "cargo test --manifest-path mux/Cargo.toml"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/reply-from": "^12.6.5",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.11.3",
    "js-yaml": "^5.2.3",
    "p-limit": "^7.3.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "undici": "^8.10.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
