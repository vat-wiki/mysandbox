{
  "name": "mysandbox",
  "version": "0.1.0",
  "description": "Web control panel for dev containers - terminal, lifecycle, batch config.",
  "type": "module",
  "bin": {
    "mysandbox": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "web/dist",
    "config.default.yaml",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch server/cli.ts --host auto",
    "serve": "tsx server/cli.ts",
    "start": "npm run build && node dist/server/cli.js",
    "typecheck": "tsc --noEmit",
    "build:server": "tsc",
    "build:web": "npm -C web run build",
    "build": "npm run build:server && npm run build:web",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/reply-from": "^12.6.5",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.11.3",
    "js-yaml": "^5.2.3",
    "p-limit": "^7.3.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "undici": "^8.10.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
