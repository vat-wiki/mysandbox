# 容器内最小可用 zsh 配置（独立、无宿主路径噪声）。
export PATH="$HOME/.local/bin:$PATH"
# 工作目录 ~（compose working_dir=/home/dev），交互 shell 起来就在 home，仓库自己 clone 进 ~/。
HISTFILE=$HOME/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE EXTENDED_HISTORY

autoload -Uz colors && colors
PROMPT='%F{cyan}%~%f %F{green}❯%f '

# ls 颜色：zsh 不像 bash 有 /etc/skel 那套 alias，裸 ls 默认无色（coreutils 9.4 颜色本身正常，
# 实测 --color=auto 正常出 ANSI 码），显式开。
alias ls='ls --color=auto'
alias ll='ls -lah'
alias la='ls -A'
alias gs='git status -sb'
alias gd='git diff'
alias gl='git log --oneline -15'

# tab 补全（git 子命令 / 文件名等；zdump 落 ~/.zcompdump，随 home 持久化）
autoload -Uz compinit && compinit

# 幽灵建议（输入时灰色提示历史命令）+ 命令语法高亮：镜像 apt 预装的两个小包（见 Dockerfile
# 尾部层），替代 oh-my-zsh——免 git clone、零框架、启动快。缺失则静默跳过（老容器不报错）。
[[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# zsh-syntax-highlighting 要求 source 在 .zshrc 最末（它包装此后所有 widget 定义）
[[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
