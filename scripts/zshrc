# 容器内 zsh 配置：oh-my-zsh 基座 + 容器特有补丁（独立、无宿主路径噪声）。
# 框架装在 /usr/share/oh-my-zsh（模板脚本下载、root 持有，随 lxc-copy 进每个容器）。
# history（share_history/去重/50000 条）、menu select + 大小写不敏感补全、ls 颜色（--color=tty
# + LS_COLORS）、git 别名体系（gst/gsb/gd/glo/glog……）omz 都自带——别再手搓，
# 这份文件只放 omz 没有的东西。注意 omz 的 gl 是 git pull，看 log 用 glo/glog。
export PATH="$HOME/.local/bin:$PATH"

export ZSH=/usr/share/oh-my-zsh
if [[ -f $ZSH/oh-my-zsh.sh ]]; then
  ZSH_THEME="af-magic"   # 与宿主机 ~/.zshrc 同款（powerline 符号，终端字体需带 powerline 字形）
  plugins=(git)
  # 模板是冻结快照、/usr/share 归 root——自动更新没意义还会在非交互终端刷提示，关掉。
  zstyle ':omz:update' mode disabled
  # omz 默认 SAVEHIST=10000，维持原来的 50000。
  SAVEHIST=50000
  source "$ZSH/oh-my-zsh.sh"
else
  # 老容器手动拷了新 zshrc 但还没装 omz：退回原手搓提示符，别每次开 shell 报错。
  alias ls='ls --color=auto'
  PROMPT='%F{cyan}%~%f %F{green}❯%f '
fi

# ll/la omz 不带，自己留（alias 展开会递归吃到上面 omz 的 ls 颜色 alias）。
alias ll='ls -lah'
alias la='ls -A'

# —— 宿主 docker 桥：DOCKER_HOST 指到宿主 dockerd（容器内免装 docker）——
# mysandbox dockerApi 开启时，hosts-sync 会把 host.docker.internal（= 网关 IP，mysandbox
# 进程内代理 2375 → 宿主 docker.sock）写进 /etc/hosts 的 services 尾块。条目存在才导出：
# 功能关了/hosts 没同步就不设，不影响容器里自装的 docker。每个新 shell 都会重导（exec 注入
# 的 DOCKER_HOST 也一样），想临时用容器本地 docker 就在会话里 unset（或删掉这段）。
if command -v docker >/dev/null 2>&1 && getent hosts host.docker.internal >/dev/null 2>&1; then
  export DOCKER_HOST=tcp://host.docker.internal:2375
fi

# —— 动态终端标题：执行中 = 命令行、空闲 = 用户@主机:路径（OSC 2）——
# web 终端 tab 标签依赖它：tmux 侧 set-titles on（terminal.ts/hostTerminal.ts 每次
# attach 设置）把 pane title 转发给前端 xterm 的 onTitleChange。omz 自带的 termsupport
# 在 tmux 内（TERM=tmux*）走 \ek 分支——实测 tmux 3.4 对该序列 pane title 与 window
# name 都不改（window name 还会被 automatic-rename 盖回前台命令名），等于什么都没设；
# 这里用 add-zsh-hook 独立注册（不覆盖 omz 钩子），恒发 OSC 2。CC/opencode 等 TUI
# 自己发的 OSC 2 会在运行中自然覆盖本钩子的标题，无需特判。普通终端（SSH 直连等）
# 收到 OSC 2 显示同样的标题，标准行为无副作用。
autoload -Uz add-zsh-hook
_msb_title() {
  local t=$1
  t=${t//$'\e'/}                    # 剔 ESC：命令名夹带序列也无法伪造 OSC
  t=${t//$'\a'/}                    # 剔 BEL：OSC 终结符
  t=${t//$'\r'/}
  t=${t//$'\n'/ }
  (( ${#t} > 60 )) && t="${t[1,57]}…"
  printf '\e]2;%s\a' "$t"
}
_msb_preexec() { _msb_title "$1" }                       # $1 = 完整命令行
_msb_precmd() { _msb_title "${(%):-%n@%m:%~}" }          # ${(%)...}：零 fork 的 prompt 展开
add-zsh-hook preexec _msb_preexec
add-zsh-hook precmd _msb_precmd

# 幽灵建议（输入时灰色提示历史命令）+ 命令语法高亮：apt 预装的两个小包，omz 不含。
# 缺失则静默跳过（老容器不报错）。
# Tab 补全与 ghost 叠渲染修复：Tab 的 widget(expand-or-complete)不在插件任何名单里，
# 默认按「modify」处理——补全菜单重画行后灰色 ghost 仍画在原位，和补全结果叠出
# "l+灰l+l" 假象（屏幕与 buffer 脱节，回车报 command not found）。列进 CLEAR_WIDGETS 让 Tab 清场。
# 必须在 source 插件之后、首个提示符之前改（precmd 时按名单绑 widget）。
[[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && {
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  ZSH_AUTOSUGGEST_CLEAR_WIDGETS+=(expand-or-complete expand-or-complete-with-prefix menu-complete menu-expand-or-complete complete-word)
}
# zsh-syntax-highlighting 要求 source 在 .zshrc 最末（它包装此后所有 widget 定义）
[[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
