# /etc/systemd/system/mysandbox-console.service（由 scripts/install.sh 以占位符填充落盘；
# __MSB_CONSOLE_TARGET__ = config listen 的 host:auto 解析 IP:port，改 listen 后重跑 install.sh 同步）
[Unit]
# socket 激活 HTTPS 门面：443 由 node 终结 TLS，再回源到 mysandbox 的 HTTP 端口。
# 刻意不设 --exit-idle-time：默认 infinity + 只数「零连接」时段，终端 WS 长连接不受影响；
# 常驻进程仅数 MB。mysandbox 重启期间 proxyd 存活，上游恢复即自动续上。
Description=mysandbox console HTTPS facade (443 -> __MSB_CONSOLE_TARGET__)
Requires=mysandbox-console.socket
After=mysandbox-console.socket

[Service]
User=__MSB_USER__
Group=__MSB_USER__
Environment=HOME=/home/__MSB_USER__
ExecStart=__MSB_NODE__ __MSB_DIR__/dist/server/facade.js --host __MSB_CONSOLE_HOST__ --port __MSB_CONSOLE_PORT__
Restart=on-failure
RestartSec=2
