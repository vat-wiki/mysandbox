# /etc/systemd/system/mysandbox-dns.service（由 scripts/install.sh 落盘同步）
[Unit]
# 本机泛解析自持：*.mysandbox.test → 127.0.0.1（端口免带门面的域名门面依赖）。
# .test 不是可注册公网域，/etc/hosts 做不了泛解析——此前靠 mihomo hosts 段应答
# （代理软件没开即解析失败），本单元让 mysandbox 自己兜住。答案用环回地址而非
# 本机 IP：443 由 mysandbox-console.socket 监听 0.0.0.0（环回天然覆盖），DHCP 换 IP
# 不过期。裸域 mysandbox.test 走 /etc/hosts（nsswitch files 优先），不经这里。
# 上游 resolv-file 指向 resolved 的 uplink resolv.conf（dnsmasq 轮询该文件，上游 IP
# 变化自动跟）。⚠️ 不能加 --no-resolv——它会连 --resolv-file 一起禁掉（warning:
# ignoring resolv-file flag → no upstream servers configured → 全部 REFUSED，实测坑）；
# 只给 --resolv-file 即可，默认的 /etc/resolv.conf 本来就是它的软链/同源。
# resolved 自身的 127.0.0.53 stub 在本机是关的（DNSStubListener=no），不会成环。
# 端口独占判定：127.0.0.1:53 已有应答方则不落盘不启用（尊重 mihomo/dnsmasq 等自配）。
Description=mysandbox local DNS (*.mysandbox.test wildcard -> loopback)
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/bin/sh -c 'test ! -e /run/mysandbox-dns.superseded'
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground \
  --pid-file=/run/mysandbox-dns.pid --user=dnsmasq \
  --listen-address=127.0.0.1 --bind-interfaces --except-interface=lo \
  --address=/.mysandbox.test/127.0.0.1 \
  --resolv-file=/run/systemd/resolve/resolv.conf \
  --log-facility=/dev/null
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
