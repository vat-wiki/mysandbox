# /etc/systemd/system/mysandbox-docker-interop.service（由 scripts/install.sh 落盘，docker 缺失时跳过安装）
[Unit]
# mysandbox 跨桥互通放行。__MSB_BRIDGE__（LXC 桥）与 mysandbox-lan（docker 服务网络，桥设备
# 钉名 br-mysandbox）分离后，docker 在 DOCKER 链有 `! -i <桥> -o <桥> -j DROP`：外来接口
# （__MSB_BRIDGE__）进 docker 容器的新连接会被丢弃。DOCKER-USER 挂在 FORWARD 最顶端
# （早于 ufw），是 docker 官方指定的用户注入点，docker 重启不清空本链内容。-o br+ 通配
# 所有 docker 桥：mysandbox-lan 重建（钉名丢失时桥名回 br-<hash>）也生效。
# docker → LXC 方向无需规则（DOCKER-FORWARD 的 -i <docker 桥> -j ACCEPT 已放行）。
# mysandbox-wg0（集群 WireGuard 隧道接口，server/wireguard.ts WG_INTERFACE，全平台同名）：
# 与 LXC 桥同待遇——集群 overlay 是可信域，成员直连服务容器固定 IP（服务不发布端口的形态）
# 必须放行，否则 raw 表 dockerd 隔离规则把 wg 进来的流量在最前面吞掉（2026-09-21 实测：
# FORWARD 计数为 0、conntrack 为空、tcpdump 见包不出桥的怪症状即它；nft trace 钉到
# raw PREROUTING 的 `-d <服务IP> ! -i <桥> drop`）。
Description=mysandbox cross-bridge interop (raw + DOCKER-USER accept from __MSB_BRIDGE__/mysandbox-wg0)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -C DOCKER-USER -i __MSB_BRIDGE__ -o br+ -j ACCEPT 2>/dev/null || iptables -I DOCKER-USER 1 -i __MSB_BRIDGE__ -o br+ -j ACCEPT'
ExecStart=/bin/sh -c 'iptables -C DOCKER-USER -i mysandbox-wg0 -o br+ -j ACCEPT 2>/dev/null || iptables -I DOCKER-USER 1 -i mysandbox-wg0 -o br+ -j ACCEPT'
# raw 表放行必须排在 dockerd 的服务 IP 隔离规则之前：docker 29 会在每次服务容器 start 时
# 重写 `-t raw -A PREROUTING -d <服务IP> ! -i <桥> -j DROP`（实测删了会在下次 start 回来，
# 无法一次性清除）；dockerd 用 -A 追加、这里用 -I 1 插入，顺序恒在前，dockerd restart 亦然。
ExecStart=/bin/sh -c 'iptables -t raw -C PREROUTING -i __MSB_BRIDGE__ -j ACCEPT 2>/dev/null || iptables -t raw -I PREROUTING 1 -i __MSB_BRIDGE__ -j ACCEPT'
ExecStart=/bin/sh -c 'iptables -t raw -C PREROUTING -i mysandbox-wg0 -j ACCEPT 2>/dev/null || iptables -t raw -I PREROUTING 1 -i mysandbox-wg0 -j ACCEPT'
ExecStop=-/bin/sh -c 'iptables -D DOCKER-USER -i __MSB_BRIDGE__ -o br+ -j ACCEPT 2>/dev/null; iptables -D DOCKER-USER -i mysandbox-wg0 -o br+ -j ACCEPT 2>/dev/null; true'
ExecStop=-/bin/sh -c 'iptables -t raw -D PREROUTING -i __MSB_BRIDGE__ -j ACCEPT 2>/dev/null; iptables -t raw -D PREROUTING -i mysandbox-wg0 -j ACCEPT 2>/dev/null; true'

[Install]
WantedBy=multi-user.target
